# Atlas Labs — run worker image.
# Separate from the web Dockerfile: the worker executes TypeScript directly via
# tsx and needs no `next build`, so this skips it entirely.
FROM node:22-alpine
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/cli/package.json packages/cli/
# Dev deps are required at runtime: tsx executes scripts/worker.ts.
RUN pnpm install --frozen-lockfile --prod=false

COPY . .

ENV NODE_ENV=production
CMD ["pnpm", "exec", "tsx", "scripts/worker.ts"]
