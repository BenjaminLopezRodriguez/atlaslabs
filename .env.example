# Atlas Labs — copy to .env (and .env.local for scripts) and fill in.
# No value in this file is a real credential. Production values live in a
# secret manager, never in files. Dev/staging/prod must not share credentials.

# --- Database (docker-compose postgres) ---
DATABASE_URL="postgresql://atlas:atlas-local-dev@localhost:5442/atlas"

# --- WorkOS AuthKit — create a NEW WorkOS application for Atlas (do not
# reuse any other project's team/environment). https://dashboard.workos.com
#   1. Enable AuthKit / User Management.
#   2. Add redirect URI http://localhost:3000/auth/callback
#   3. Set sign-in endpoint http://localhost:3000/sign-in
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"

# --- Queue / cache (docker-compose redis) ---
REDIS_URL="redis://localhost:6389"

# --- Object storage (docker-compose minio) ---
S3_ENDPOINT="http://localhost:9010"
S3_ACCESS_KEY_ID="atlas"
S3_SECRET_ACCESS_KEY="atlas-local-dev"
S3_BUCKET="atlas-artifacts"

# --- Model provider (operator must create; runs use a stub without it) ---
ANTHROPIC_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
