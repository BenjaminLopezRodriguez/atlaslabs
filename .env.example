# Atlas Labs — copy to .env (and .env.local for scripts) and fill in.
# No value in this file is a real credential. Production values live in a
# secret manager, never in files. Dev/staging/prod must not share credentials.

# --- Database (docker-compose postgres) ---
DATABASE_URL="postgresql://atlas:atlas-local-dev@localhost:5442/atlas"

# --- WorkOS AuthKit — create a NEW WorkOS application for Atlas (do not
# reuse any other project's team/environment). https://dashboard.workos.com
#   1. Enable AuthKit / User Management.
#   2. Add redirect URI http://localhost:3000/auth/callback
#   3. Set sign-in endpoint http://localhost:3000/sign-in
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"

# --- Queue / cache (docker-compose redis) ---
REDIS_URL="redis://localhost:6389"

# --- Object storage (docker-compose minio) ---
S3_ENDPOINT="http://localhost:9010"
S3_ACCESS_KEY_ID="atlas"
S3_SECRET_ACCESS_KEY="atlas-local-dev"
S3_BUCKET="atlas-artifacts"

# --- Model provider (operator must create; runs use a stub without it) ---
# Prose and review always run on Anthropic.
ANTHROPIC_API_KEY=""
# The coding agent (the tool-use loop that edits a space) prefers DeepSeek V4
# Flash. Set this and it becomes the default; leave it unset and the loop falls
# back to Anthropic. With neither set, the loop runs the deterministic stub.
DEEPSEEK_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Atlas machine backend: "mock" (default, in-process) or "modal" (real VMs).
ATLAS_MACHINE_DRIVER="mock"
# Only needed when ATLAS_MACHINE_DRIVER=modal. Deploy modal/atlas_sandboxes.py,
# then: modal secret create atlas-bridge ATLAS_BRIDGE_SECRET=<same value>
ATLAS_MODAL_BRIDGE_URL=""
ATLAS_MODAL_BRIDGE_SECRET=""

# --- Ping delivery (email) ---
# Provisioned by the Resend marketplace integration:
#   vercel integration add resend/resend-email -m domain=<yours> -m region=us-east-1
# Without it, pings still work — they just emit a reply link and notify nobody.
RESEND_API_KEY=""
# Must be on a domain verified in Resend, or every send is rejected.
ATLAS_PING_FROM="Atlas <atlas@atlaslabs.id>"

# --- Connections (GitHub, Railway) ---
# Encrypts third-party tokens at rest. Any passphrase of 32+ chars; changing it
# makes every stored connection unreadable, so users must reconnect.
ATLAS_ENCRYPTION_KEY=""
# GitHub OAuth app. Callback URL must be <app>/api/github/callback.
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Railway needs no app credentials: each user pastes a project token in
# Settings → Connections, which is what `railway up` runs with.

# --- Space checkpoints (S3 merkle store) ---
# Content-addressed snapshots of what the agent wrote, so a space can be rolled
# back without being a git repo. Unset = checkpoints compute but do not persist.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Top-level key prefix; default "spaces".
S3_SPACE_PREFIX="spaces"
